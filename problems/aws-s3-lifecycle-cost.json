  ],
  "solution": "function calculateS3LifecycleCost(objects, costs) {\n  const classCount = {};\n  for (const [id, className] of objects) {\n    if (classCount[className] === undefined) {\n      classCount[className] = 0;\n    }\n    classCount[className]++;\n  }\n  let totalCost = 0;\n  for (const className in classCount) {\n    totalCost += classCount[className] * costs[className];\n  }\n  return totalCost;\n}",
